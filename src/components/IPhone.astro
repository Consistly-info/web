---
/**
 * A CSS iPhone frame. Set --phone-w on the frame or a parent to resize it.
 * Everything inside scales through --u, which equals one iOS point.
 */
interface Props {
  label: string;
  dark?: boolean;
  time?: boolean;
}

const { label, dark = false, time = true } = Astro.props;
---

<div class:list={["iphone", { dark }]} role="group" aria-label={label}>
  <div class="screen">
    <div class="status" aria-hidden="true">
      {time ? <span class="time">08:08</span> : <span />}
      <span class="island"></span>
      <span class="glyphs">
        <svg viewBox="0 0 18 12" width="18" height="12">
          <rect
            x="0"
            y="8"
            width="3"
            height="4"
            rx=".8"
            fill="currentColor"
          ></rect>
          <rect
            x="5"
            y="5.5"
            width="3"
            height="6.5"
            rx=".8"
            fill="currentColor"
          ></rect>
          <rect
            x="10"
            y="3"
            width="3"
            height="9"
            rx=".8"
            fill="currentColor"
          ></rect>
          <rect
            x="15"
            y="0"
            width="3"
            height="12"
            rx=".8"
            fill="currentColor"
          ></rect>
        </svg>
        <svg viewBox="0 0 26 12" width="26" height="12">
          <rect
            x=".5"
            y=".5"
            width="22"
            height="11"
            rx="3.2"
            fill="none"
            stroke="currentColor"
            opacity=".4"
          ></rect>
          <rect
            x="2"
            y="2"
            width="17"
            height="8"
            rx="2"
            fill="currentColor"
          ></rect>
          <rect
            x="24"
            y="4"
            width="1.6"
            height="4"
            rx=".8"
            fill="currentColor"
            opacity=".5"
          ></rect>
        </svg>
      </span>
    </div>
    <slot />
  </div>
</div>

<style>
  .iphone {
    --u: calc(var(--phone-w, 300px) / 393);
    position: relative;
    flex: none;
    width: var(--phone-w, 300px);
    aspect-ratio: 393 / 852;
    padding: calc(var(--u) * 11);
    background: #1c1e21;
    border-radius: calc(var(--u) * 66);
    box-shadow:
      inset 0 0 0 calc(var(--u) * 2) #3f4348,
      0 1px 2px rgb(18 40 70 / 0.12),
      0 28px 60px -22px rgb(18 40 70 / 0.32);
  }

  .screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: #f3f6fa;
    color: #171717;
    border-radius: calc(var(--u) * 55);
    font-size: calc(var(--u) * 15);
    line-height: 1.3;
    text-align: left;
  }

  .dark .screen {
    background: #0c1626;
    color: #fff;
  }

  .status {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: calc(var(--u) * 54);
    padding-inline: calc(var(--u) * 28);
    font-size: calc(var(--u) * 15.5);
    font-weight: 600;
  }

  .time {
    text-align: center;
  }

  .island {
    width: calc(var(--u) * 112);
    height: calc(var(--u) * 32);
    background: #000;
    border-radius: 99px;
  }

  .glyphs {
    display: flex;
    justify-content: center;
    gap: calc(var(--u) * 5);
  }

  .glyphs svg {
    width: auto;
    height: calc(var(--u) * 11.5);
  }
</style>
