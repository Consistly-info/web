---
/**
 * The Consistly companion. Every appearance on the site goes through here.
 * Images are 960px squares with the feet resting at about 97% of the height,
 * and the accessory layer shares that coordinate system.
 */
import small from "../assets/mascot/mascot-240.webp";
import medium from "../assets/mascot/mascot-480.webp";
import large from "../assets/mascot/mascot-960.webp";

type Accessory = "scarf" | "glasses" | "hat" | "crown";

interface Props {
  /** Alt text. Leave empty when the mascot is decorative. */
  label?: string;
  /** Rendered width, used to pick the right image file. */
  sizes?: string;
  accessories?: Accessory[];
  /** Render scarf, glasses and hat so a parent can toggle them with CSS. */
  dressable?: boolean;
  /** Load immediately. Use only for the mascot in the hero. */
  eager?: boolean;
  /** A slow, subtle breathing motion. */
  idle?: boolean;
}

const {
  label = "",
  sizes = "240px",
  accessories = [],
  dressable = false,
  eager = false,
  idle = false,
} = Astro.props;

const has = (item: Accessory) => dressable || accessories.includes(item);
const hasOverlay = dressable || accessories.length > 0;
---

<div class="mascot">
  <div class:list={["figure", { idle }]}>
    <img
      src={medium.src}
      srcset={`${small.src} 240w, ${medium.src} 480w, ${large.src} 960w`}
      sizes={sizes}
      width="960"
      height="960"
      alt={label}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
    />
    {hasOverlay && (
      <svg class="layer" viewBox="0 0 960 960" aria-hidden="true">
        {has("scarf") && (
          <g class="acc acc-scarf">
            <path
              d="M628 560c34-6 70-16 98-30l40 178c4 18-8 30-26 35-30 8-62 9-88 3-14-3-22-12-23-26Z"
              fill="#e8796b"
            />
            <path
              d="M643 660c30 2 66-3 104-15l6 30c-34 11-74 15-106 12Z"
              fill="#f9b4a8"
            />
            <path
              d="M170 472c112 74 516 74 628 0 22 22 22 72 0 94-112 76-516 76-628 0-22-22-22-72 0-94Z"
              fill="#f48f80"
            />
            <path
              d="M170 544c112 74 516 74 628 0l0 22c-112 76-516 76-628 0Z"
              fill="#e8796b"
            />
            <path
              d="M214 508c100 50 300 62 430 34"
              fill="none"
              stroke="#fbc1b6"
              stroke-width="11"
              stroke-linecap="round"
            />
          </g>
        )}
        {has("glasses") && (
          <g class="acc acc-glasses">
            <circle cx="354" cy="341" r="74" fill="#fff" fill-opacity=".16" />
            <circle cx="610" cy="341" r="74" fill="#fff" fill-opacity=".16" />
            <g fill="none" stroke="#24334d" stroke-width="13">
              <circle cx="354" cy="341" r="74" />
              <circle cx="610" cy="341" r="74" />
              <path d="M428 322c34-20 74-20 108 0" stroke-linecap="round" />
            </g>
          </g>
        )}
        {has("hat") && (
          <g class="acc acc-hat">
            <path
              d="M238 178c60 40 430 40 492 0 28 8 18 42-22 58-110 44-340 44-448 0-40-16-50-50-22-58Z"
              fill="#e7c384"
            />
            <path
              d="M332 184c-8-188 312-188 304 0-90 28-214 28-304 0Z"
              fill="#f3d9a6"
            />
            <path
              d="M332 150c90 28 214 28 304 0l0 36c-90 28-214 28-304 0Z"
              fill="#2a6fc4"
            />
            <path
              d="M380 112c6-34 34-52 62-58"
              fill="none"
              stroke="#fbeccb"
              stroke-width="12"
              stroke-linecap="round"
            />
          </g>
        )}
        {has("crown") && (
          <g class="acc acc-crown" stroke-linejoin="round">
            <path
              d="M388 176 368 76l64 44 52-72 52 72 64-44-20 100c-60 18-132 18-192 0Z"
              fill="#f7c95c"
              stroke="#f7c95c"
              stroke-width="12"
            />
            <path
              d="M386 150c62 18 134 18 196 0l-6 28c-58 18-126 18-184 0Z"
              fill="#e2a930"
            />
            <circle cx="484" cy="118" r="14" fill="#fff4d2" />
            <circle cx="368" cy="74" r="12" fill="#f7c95c" />
            <circle cx="484" cy="46" r="12" fill="#f7c95c" />
            <circle cx="600" cy="74" r="12" fill="#f7c95c" />
          </g>
        )}
      </svg>
    )}
  </div>
</div>

<style>
  .mascot {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  /* A soft floor shadow that works on any background. */
  .mascot::before {
    content: "";
    position: absolute;
    bottom: 0.5%;
    left: 14%;
    width: 72%;
    height: 7%;
    background: radial-gradient(
      closest-side,
      rgb(24 60 112 / 0.28),
      rgb(24 60 112 / 0)
    );
  }

  .figure {
    position: relative;
    width: 100%;
    height: 100%;
    transform-origin: 50% 97%;
  }

  img,
  .layer {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .idle {
    animation: breathe 4.2s ease-in-out infinite;
  }

  @keyframes breathe {
    0%,
    100% {
      transform: scale(1, 1);
    }
    50% {
      transform: scale(1.012, 0.985);
    }
  }
</style>
