---
import Mascot from "../Mascot.astro";
import SectionHead from "../SectionHead.astro";

const XP = 2900;

const groups = [
  {
    name: "Hats",
    slot: "hat",
    items: [
      { id: "hat", name: "Sun hat", cost: 1000 },
      { id: "beanie", name: "Beanie", cost: 2400 },
      { id: "crown", name: "Crown", cost: 5000 },
    ],
  },
  {
    name: "Clothes",
    slot: "clothes",
    items: [
      { id: "scarf", name: "Scarf", cost: 300 },
      { id: "bowtie", name: "Bow tie", cost: 1500 },
      { id: "sweater", name: "Sweater", cost: 3000 },
    ],
  },
  {
    name: "Extras",
    slot: "extra",
    items: [{ id: "glasses", name: "Glasses", cost: 600 }],
  },
] as const;

const fmt = (n: number) => n.toLocaleString("en-US");
const next = groups
  .flatMap((group) => [...group.items])
  .filter((item) => item.cost > XP)
  .sort((a, b) => a.cost - b.cost)[0];
const DEFAULT_LOOK = ["scarf"];
---

<section class="section companion" aria-labelledby="companion-title">
  <div class="page">
    <SectionHead
      id="companion-title"
      eyebrow="Personal companion"
      title="Grow together, one habit at a time."
      lead="Every habit you complete earns XP, and XP unlocks new things for your companion, like hats and clothes."
    />

    <div class="layout reveal">
      <div class="scene" data-look data-on={DEFAULT_LOOK.join(" ")}>
        <svg
          class="world"
          viewBox="0 0 800 480"
          preserveAspectRatio="xMidYMax slice"
          aria-hidden="true"
        >
          <rect width="800" height="480" fill="#b4d3f7"></rect>
          <circle cx="570" cy="104" r="36" fill="#fbe6a8"></circle>
          <g fill="#fff">
            <ellipse cx="262" cy="106" rx="50" ry="15"></ellipse>
            <ellipse cx="292" cy="92" rx="32" ry="15"></ellipse>
            <ellipse cx="450" cy="58" rx="34" ry="10"></ellipse>
          </g>
          <path
            d="M0 340C120 250 250 260 400 330S680 270 800 310V480H0Z"
            fill="#9fc3f0"
          ></path>
          <path d="M0 386C200 350 600 350 800 386V480H0Z" fill="#8bb5ec"></path>
          <path d="M120 480C180 404 620 404 680 480Z" fill="#6f9fe2"></path>
        </svg>

        <div class="character">
          <Mascot
            label="The Consistly companion wearing the items you pick"
            accessories={[
              "sweater",
              "bowtie",
              "scarf",
              "glasses",
              "hat",
              "beanie",
              "crown",
            ]}
            sizes="(max-width: 900px) 62vw, 360px"
            idle
          />
        </div>
        <span class="note sample">Example items and XP</span>
      </div>

      <div class="wardrobe" data-wardrobe>
        <div class="total">
          <p class="amount">
            <b>{fmt(XP)}</b> XP
          </p>
          <div class="bar">
            <span style={`width:${(XP / next.cost) * 100}%`}></span>
          </div>
          <p class="to-next">
            {fmt(next.cost - XP)} XP to unlock the {next.name}
          </p>
        </div>

        {groups.map((group) => (
          <div class="group">
            <h3 id={`wardrobe-${group.slot}`}>{group.name}</h3>
            <div
              class="items"
              role="group"
              aria-labelledby={`wardrobe-${group.slot}`}
            >
              {group.items.map((item) => {
                const locked = item.cost > XP;
                return (
                  <button
                    type="button"
                    class:list={["item", { locked }]}
                    aria-pressed={
                      DEFAULT_LOOK.includes(item.id) ? "true" : "false"
                    }
                    data-item={item.id}
                    data-slot={group.slot}
                  >
                    <b>{item.name}</b>
                    <span>
                      {locked && (
                        <svg viewBox="0 0 12 12" aria-hidden="true">
                          <path d="M3.5 5.5V4a2.5 2.5 0 0 1 5 0v1.5M2.5 5.5h7v5h-7Z" />
                        </svg>
                      )}
                      {locked ? `${fmt(item.cost)} XP` : "Unlocked"}
                    </span>
                  </button>
                );
              })}
            </div>
          </div>
        ))}
        <p class="note">Try it: tap an item to try it on, even locked ones.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .companion {
    background: var(--sky-soft);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    margin-top: clamp(40px, 6vw, 72px);
  }

  .scene {
    position: relative;
    display: grid;
    align-items: end;
    justify-items: center;
    aspect-ratio: 1 / 1;
    max-height: 640px;
    width: 100%;
    overflow: hidden;
    border-radius: 24px;
  }

  .world {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .character {
    position: relative;
    width: min(66%, 400px);
    margin-bottom: 4%;
  }

  .scene :global(.acc) {
    display: none;
  }

  [data-on~="hat"] :global(.acc-hat),
  [data-on~="beanie"] :global(.acc-beanie),
  [data-on~="crown"] :global(.acc-crown),
  [data-on~="scarf"] :global(.acc-scarf),
  [data-on~="bowtie"] :global(.acc-bowtie),
  [data-on~="sweater"] :global(.acc-sweater),
  [data-on~="glasses"] :global(.acc-glasses) {
    display: block;
  }

  .sample {
    position: absolute;
    top: 14px;
    right: 18px;
    color: #1f3b63;
  }

  .total {
    padding-bottom: 24px;
    border-bottom: 1px solid rgb(28 79 146 / 0.14);
  }

  .amount {
    color: var(--muted);
    font-size: 18px;
    font-weight: 500;
  }

  .amount b {
    color: var(--ink);
    font-size: clamp(44px, 5vw, 60px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .bar {
    height: 8px;
    margin-top: 12px;
    overflow: hidden;
    background: rgb(28 79 146 / 0.14);
    border-radius: 99px;
  }

  .bar span {
    display: block;
    height: 100%;
    background: var(--blue);
    border-radius: 99px;
  }

  .to-next {
    margin-top: 8px;
    color: var(--muted);
    font-size: 15px;
  }

  .group {
    margin-top: 22px;
  }

  h3 {
    font-size: 15px;
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 10px;
  }

  .item {
    display: grid;
    gap: 1px;
    min-height: 60px;
    padding: 9px 11px;
    background: var(--surface);
    border: 1.5px solid var(--line);
    border-radius: 14px;
    text-align: left;
    transition:
      border-color 0.2s,
      background 0.2s;
  }

  .item:hover {
    border-color: var(--blue);
  }

  .item b {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .item span {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--muted);
    font-size: 13px;
  }

  .item svg {
    flex: none;
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .item[aria-pressed="true"] {
    background: var(--sky);
    border-color: var(--blue-deep);
  }

  .wardrobe .note {
    margin-top: 16px;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .scene {
      aspect-ratio: 4 / 3;
    }

    .character {
      width: min(52%, 340px);
    }
  }

  @media (max-width: 480px) {
    .scene {
      aspect-ratio: 1;
    }

    .character {
      width: 72%;
    }

    .item {
      padding-inline: 9px;
    }

    .item b {
      font-size: 14px;
    }

    .item span {
      font-size: 12px;
    }
  }
</style>

<script>
  const wardrobe = document.querySelector<HTMLElement>("[data-wardrobe]");
  const look = document.querySelector<HTMLElement>("[data-look]");

  if (wardrobe && look) {
    const items = wardrobe.querySelectorAll<HTMLButtonElement>("[data-item]");

    items.forEach((item) =>
      item.addEventListener("click", () => {
        const on = item.getAttribute("aria-pressed") !== "true";
        // One item per slot, so hats replace hats and clothes replace clothes.
        items.forEach((other) => {
          if (other.dataset.slot === item.dataset.slot) {
            other.setAttribute("aria-pressed", "false");
          }
        });
        item.setAttribute("aria-pressed", String(on));
        look.dataset.on = [...items]
          .filter((i) => i.getAttribute("aria-pressed") === "true")
          .map((i) => i.dataset.item)
          .join(" ");
      }),
    );
  }
</script>
