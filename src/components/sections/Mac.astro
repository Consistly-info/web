---
import MacBook from "../MacBook.astro";
import SectionHead from "../SectionHead.astro";

const points = [
  [
    "A MacBook app",
    "Check in on your habits and see your year on a bigger screen.",
  ],
  [
    "The same widgets as your phone",
    "Add your checklist, contribution graph, streak, and progress to your Mac desktop, just like on iPhone.",
  ],
  [
    "Coming to the App Store",
    "Consistly will be released on the App Store soon.",
  ],
];
---

<section class="section" id="mac" aria-labelledby="mac-title">
  <div class="page">
    <SectionHead
      id="mac-title"
      eyebrow="Mac app, coming soon"
      title="On your MacBook, too."
      lead="Consistly is also coming to the Mac, with the widgets you know from your phone right on your desktop."
      center
    />

    <figure class="device reveal">
      <MacBook />
      <figcaption class="note">
        Concept design with sample data. The final app may differ.
      </figcaption>
    </figure>

    <dl class="points reveal">
      {points.map(([name, text]) => (
        <div>
          <dt>{name}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .device {
    --mac-w: min(100vw - var(--gutter) * 2, 1040px);
    display: grid;
    gap: 20px;
    margin-top: clamp(48px, 6vw, 80px);
    text-align: center;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px clamp(24px, 4vw, 48px);
    margin-top: clamp(40px, 5vw, 64px);
  }

  dt {
    font-size: 17px;
    font-weight: 620;
    letter-spacing: -0.014em;
  }

  dd {
    margin-top: 4px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.42;
  }

  @media (max-width: 760px) {
    .points {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .device {
      gap: 10px;
      margin-top: 20px;
    }

    .points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 16px;
    }

    .points > div:last-child {
      grid-column: 1 / -1;
    }

    dt {
      font-size: 14px;
    }

    dd {
      margin-top: 1px;
      font-size: 13px;
      line-height: 1.35;
    }
  }
</style>
