---
import IPhone from "../IPhone.astro";
import SectionHead from "../SectionHead.astro";
import Widget from "../Widget.astro";
import HomeScreen from "../screens/HomeScreen.astro";
import LockScreen from "../screens/LockScreen.astro";
---

<section class="section band widgets" aria-labelledby="widgets-title">
  <div class="page">
    <SectionHead
      id="widgets-title"
      eyebrow="iOS widgets, planned for launch"
      title="Your habits, always within reach."
      lead="Check in on your day from your Home Screen and Lock Screen, without opening the app."
      center
    />

    <div class="wall reveal">
      <div class="col left">
        <figure>
          <div class="wide">
            <Widget kind="checklist" />
          </div>
          <figcaption>Daily habit checklist</figcaption>
        </figure>
        <figure>
          <Widget kind="streak" />
          <figcaption>Streak counter</figcaption>
        </figure>
      </div>

      <div class="phones">
        <figure class="phone-home">
          <IPhone label="Concept of Consistly widgets on an iPhone Home Screen">
            <HomeScreen />
          </IPhone>
          <figcaption>Home Screen</figcaption>
        </figure>
        <figure class="phone-lock">
          <IPhone
            label="Concept of Consistly widgets on an iPhone Lock Screen"
            dark
            time={false}
          >
            <LockScreen />
          </IPhone>
          <figcaption>Lock Screen widgets</figcaption>
        </figure>
      </div>

      <div class="col right">
        <figure>
          <div class="wide">
            <Widget kind="graph" tone="pink" />
          </div>
          <figcaption>Contribution graph</figcaption>
        </figure>
        <figure>
          <Widget kind="progress" tone="pink" />
          <figcaption>Progress</figcaption>
        </figure>
      </div>
    </div>
    <p class="note foot">
      Concept designs with sample data. Widgets are planned and may change
      before launch.
    </p>
  </div>
</section>

<style>
  .widgets {
    background: #f7f8fa;
  }

  .wall {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 3vw, 40px);
    margin-top: clamp(48px, 6vw, 80px);
  }

  .phones {
    display: flex;
    gap: clamp(16px, 2vw, 28px);
    --phone-w: clamp(220px, 20vw, 276px);
  }

  .col {
    /* One iOS point on screen; standalone widgets sit a little under true size. */
    --u: 0.7px;
    display: grid;
    gap: 36px;
  }

  .left {
    justify-items: end;
  }

  .right {
    justify-items: start;
  }

  figure {
    display: grid;
    gap: 12px;
  }

  figcaption {
    color: var(--muted);
    font-size: 13px;
    font-weight: 500;
    text-align: center;
  }

  .foot {
    margin-top: 40px;
    text-align: center;
  }

  @media (max-width: 1160px) {
    .wall {
      grid-template-columns: 1fr 1fr;
    }

    .phones {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-content: center;
      --phone-w: clamp(220px, 34vw, 300px);
    }

    .col {
      --u: 0.85px;
      justify-items: center;
    }
  }

  @media (max-width: 680px) {
    .wall {
      grid-template-columns: 1fr;
    }

    .phones {
      flex-direction: column;
      align-items: center;
      gap: 36px;
      --phone-w: min(76vw, 300px);
    }

    .col {
      --u: min(0.9px, calc((100vw - 40px) / 338));
    }
  }
</style>
