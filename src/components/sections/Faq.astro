---
import Mascot from "../Mascot.astro";

const faqs = [
  {
    q: "What is Consistly?",
    a: "Consistly is an upcoming habit tracker and personal growth companion for iPhone and Mac. It brings together daily habit tracking, a GitHub-inspired contribution graph, a character that grows with you, and rewards that make progress feel good.",
  },
  {
    q: "How does the contribution graph work?",
    a: "Each square represents a day. The more of your habits you complete, the deeper its color. Over time the squares build into a picture of your year, and you'll be able to view all your habits together or look at each one on its own.",
  },
  {
    q: "What is the personal companion?",
    a: "It's a small character that keeps you company as you build your habits. There are two companions, one blue and one pink, and the XP you earn unlocks new things for them, like hats and clothes.",
  },
  {
    q: "How do XP and gems work?",
    a: "The plan is simple: completing habits and challenges earns XP, which unlocks new items for your companion, like hats and clothes, and gems, which you can spend on other rewards. Exact amounts are still being worked out.",
  },
  {
    q: "Is Consistly free?",
    a: "Pricing hasn't been decided or announced yet. It will be shared here before launch.",
  },
  {
    q: "Does Consistly require an account?",
    a: "The intention is that basic usage won't require an account. This will be confirmed before launch.",
  },
  {
    q: "When will Consistly launch?",
    a: "Consistly will be released on the App Store soon. There's no exact date to share yet.",
  },
  {
    q: "Will Consistly support iOS widgets?",
    a: "Yes, that's the plan. Home Screen and Lock Screen widgets are being designed for your habit checklist, contribution graph, streak, and daily progress.",
  },
  {
    q: "Will I be able to challenge my friends?",
    a: "That's the plan. Social Challenges is a planned feature that lets you invite friends, track a habit together, and see your progress in a shared contribution graph. Because you'd be sharing progress with people you invite, how that sharing works will be explained before it's released.",
  },
  {
    q: "Will there be a Mac app?",
    a: "Yes. A Consistly app for MacBook is planned, and you'll be able to add the same widgets you use on your phone to your Mac desktop.",
  },
];
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="page layout">
    <div class="head reveal">
      <p class="eyebrow">FAQ</p>
      <h2 class="title" id="faq-title">
        Questions, answered.
      </h2>
      <div class="helper">
        <Mascot character="pink" sizes="200px" />
      </div>
    </div>

    <div class="list reveal">
      {faqs.map((item, i) => (
        <details name="faq" open={i === 0}>
          <summary>
            {item.q}
            <span class="plus" aria-hidden="true" />
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: 40px clamp(40px, 7vw, 96px);
    align-items: start;
  }

  .head {
    position: sticky;
    top: 96px;
  }

  .title {
    margin-top: 12px;
    font-size: clamp(36px, 4.6vw, 54px);
  }

  .helper {
    width: clamp(120px, 15vw, 200px);
    margin-top: 28px;
  }

  details {
    border-bottom: 1px solid var(--line);
    interpolate-size: allow-keywords;
  }

  details::details-content {
    height: 0;
    overflow: clip;
    transition:
      height 0.3s var(--ease),
      content-visibility 0.3s allow-discrete;
  }

  details[open]::details-content {
    height: auto;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 20px;
    cursor: pointer;
    font-size: clamp(18px, 2vw, 20px);
    font-weight: 600;
    letter-spacing: -0.016em;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--blue-deep);
  }

  .plus {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .plus::before,
  .plus::after {
    content: "";
    position: absolute;
    top: 6px;
    left: 0;
    width: 14px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.3s var(--ease);
  }

  .plus::after {
    transform: rotate(90deg);
  }

  details[open] .plus::after {
    transform: rotate(0deg);
  }

  details p {
    max-width: 62ch;
    padding-bottom: 24px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .head {
      position: static;
    }

    .helper {
      display: none;
    }
  }
</style>
