---
import AppStoreBadge from "../AppStoreBadge.astro";
import Mascot from "../Mascot.astro";
---

<section class="soon-section" aria-labelledby="soon-title">
  <div class="page inner reveal">
    <div class="art">
      <div>
        <Mascot label="The blue Consistly companion" sizes="200px" idle />
      </div>
      <div>
        <Mascot
          character="pink"
          label="The pink Consistly companion"
          sizes="200px"
          idle
        />
      </div>
    </div>
    <h2 class="title" id="soon-title">
      Your journey starts with one small habit.
    </h2>
    <p class="lead">Something good is growing. Consistly is coming soon.</p>

    <div class="grow" aria-hidden="true">
      {Array.from({ length: 14 }, (_, i) => (
        <i style={`--i:${i}`} />
      ))}
    </div>
    <p class="soon">Coming Soon</p>
    <div class="store">
      <AppStoreBadge />
    </div>
  </div>
</section>

<style>
  .soon-section {
    padding-block: var(--section-y);
    background: var(--sky);
    text-align: center;
  }

  .inner {
    display: grid;
    justify-items: center;
  }

  .art {
    display: flex;
    justify-content: center;
  }

  .art > div {
    width: clamp(130px, 16vw, 200px);
  }

  .art > div + div {
    margin-left: -14px;
  }

  .title {
    max-width: 840px;
    margin-top: 12px;
  }

  .lead {
    margin-top: 20px;
    color: #2b4a75;
  }

  /* A row of days filling in on a loop: the site's one ambient animation. */
  .grow {
    display: flex;
    gap: 5px;
    margin-block: 40px 20px;
  }

  .grow i {
    width: clamp(12px, 3vw, 18px);
    aspect-ratio: 1;
    border-radius: 22%;
    background: rgb(28 79 146 / 0.14);
    animation: fill 6s calc(var(--i) * 0.28s) var(--ease) infinite;
  }

  @keyframes fill {
    0% {
      background: rgb(28 79 146 / 0.14);
    }
    12%,
    72% {
      background: var(--blue);
    }
    88%,
    100% {
      background: rgb(28 79 146 / 0.14);
    }
  }

  .store {
    margin-top: 20px;
  }

  .soon {
    background: var(--blue-deep);
    color: #fff;
  }

  .soon::before {
    background: #a9d2ff;
  }

  @media (prefers-reduced-motion: reduce) {
    .grow i {
      animation: none;
      background: var(--blue);
    }
  }
</style>
