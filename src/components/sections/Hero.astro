---
import AppStoreBadge from "../AppStoreBadge.astro";
import Heat from "../Heat.astro";
import IPhone from "../IPhone.astro";
import Mascot from "../Mascot.astro";
import TodayScreen from "../screens/TodayScreen.astro";
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="page intro">
    <p class="soon">Coming Soon</p>
    <h1 id="hero-title">
      Build habits.
      <br />
      <span>Watch yourself grow.</span>
    </h1>
    <p class="lead">
      Your personal growth companion. Build better habits, visualize your
      progress, and celebrate every little step forward, on your own or with the
      people you love.
    </p>
    <div class="store">
      <AppStoreBadge />
    </div>
  </div>

  <div class="stage">
    <div class="strip">
      <Heat weeks={52} mix />
    </div>
    <div class="phone">
      <IPhone label="Concept of the Consistly Today screen">
        <TodayScreen />
      </IPhone>
    </div>
    <div class="buddy">
      <Mascot
        label="The Consistly companion, a round, soft blue character with a small tuft of hair"
        sizes="(max-width: 680px) 150px, 290px"
        eager
        idle
        blink
      />
    </div>
    <div class="buddy pink">
      <Mascot
        character="pink"
        label="A second Consistly companion, a round, soft pink character with a small bow"
        sizes="(max-width: 680px) 150px, 290px"
        eager
        idle
        blink
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(48px, 7vw, 84px);
    overflow: clip;
    text-align: center;
  }

  h1 {
    margin-top: 22px;
    font-size: clamp(44px, 8.4vw, 96px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  h1 span {
    color: var(--blue-deep);
  }

  .lead {
    max-width: 620px;
    margin: 24px auto 0;
  }

  .store {
    margin-top: 28px;
  }

  /* The year of activity runs behind the phone like a landscape, and the
     companion stands on it. */
  .stage {
    --phone-w: clamp(250px, 26vw, 330px);
    --strip-top: calc(var(--phone-w) * 0.8);
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: clamp(48px, 6vw, 72px);
    /* Crop the phone so the page flows on into the next section */
    height: calc(var(--phone-w) * 1.86);
    clip-path: inset(-200px 0 0 0);
    /* A soft glow behind each companion, in its own color. */
    background:
      radial-gradient(closest-side, var(--blue-bg), rgb(242 248 255 / 0))
        no-repeat calc(50% - var(--phone-w) * 1.05) 0 / calc(var(--phone-w) * 2)
        100%,
      radial-gradient(closest-side, var(--pink-bg), rgb(255 245 248 / 0))
        no-repeat calc(50% + var(--phone-w) * 1.05) 0 / calc(var(--phone-w) * 2)
        100%;
    animation: rise 1s var(--ease) both;
  }

  .phone {
    position: relative;
    z-index: 1;
  }

  .strip {
    position: absolute;
    top: var(--strip-top);
    left: 50%;
    width: max(100%, 1180px);
    max-width: 1560px;
    padding-inline: 24px;
    transform: translateX(-50%);
    --gap: 4px;
    animation: wipe 1.8s 0.15s var(--ease) both;
  }

  .buddy {
    position: absolute;
    z-index: 2;
    top: calc(var(--strip-top) - var(--buddy) * 0.965);
    left: calc(50% - var(--phone-w) / 2 - var(--buddy) * 1.06);
    width: var(--buddy);
    --buddy: clamp(130px, 20vw, 290px);
    animation: settle 1s 0.5s var(--ease) both;
  }

  .pink {
    left: calc(50% + var(--phone-w) / 2 + var(--buddy) * 0.06);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }

  @keyframes wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.92);
    }
  }

  @media (max-width: 680px) {
    .hero {
      padding-top: 24px;
    }

    h1 {
      margin-top: 14px;
      font-size: clamp(30px, 9.6vw, 56px);
    }

    .lead {
      margin-top: 12px;
    }

    .store {
      margin-top: 16px;
    }

    .stage {
      --phone-w: min(54vw, 260px);
      height: calc(var(--phone-w) * 1.3);
      margin-top: 24px;
    }

    .strip {
      width: max(100%, 820px);
      --gap: 3px;
    }

    .buddy {
      --buddy: min(21.5vw, 130px);
    }
  }
</style>
