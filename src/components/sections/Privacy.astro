---
import Mascot from "../Mascot.astro";

const principles = [
  {
    name: "Local-first experience",
    text: "Your habit history is intended to live on your device first.",
    icon: "M8 3h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm3 15h2",
  },
  {
    name: "No mandatory account",
    text: "The goal is that basic tracking never requires you to sign up.",
    icon: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8c.8-3.5 3.5-5.5 7-5.5s6.2 2 7 5.5M4 4l16 16",
  },
  {
    name: "Your history, your call",
    text: "You should stay in control of your record, including removing it.",
    icon: "M4 12a8 8 0 1 0 2.5-5.8L4 8.5M4 4v4.5h4.5M12 8v4l3 2",
  },
  {
    name: "Privacy-conscious design",
    text: "A habit tracker should only ask for what it actually needs.",
    icon: "M12 3 5 6v5.5c0 4.3 2.9 7.7 7 9.5 4.1-1.8 7-5.2 7-9.5V6l-7-3Zm-3 9 2.2 2.2L15.5 10",
  },
];
---

<section class="privacy section" id="privacy" aria-labelledby="privacy-title">
  <div class="page">
    <div class="top reveal">
      <div>
        <p class="eyebrow">Privacy</p>
        <h2 class="title" id="privacy-title">
          Your progress. Your data.
        </h2>
        <p class="lead">
          Your habits are personal. Privacy is the philosophy Consistly is being
          built around, not a feature added at the end.
        </p>
      </div>
      <div class="art">
        <Mascot sizes="260px" />
      </div>
    </div>

    <ul class="grid reveal">
      {principles.map((item) => (
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={item.icon} />
          </svg>
          <h3>{item.name}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>

    <p class="disclaimer reveal">
      These are our intended principles while the app is in development. Exact
      technical details will be confirmed before launch.
    </p>
  </div>
</section>

<style>
  .privacy {
    background: var(--navy);
    color: #fff;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .art {
    flex: none;
    width: clamp(150px, 20vw, 260px);
  }

  .eyebrow {
    color: #a9d2ff;
  }

  .title {
    margin-top: 12px;
    max-width: 760px;
  }

  .lead {
    max-width: 620px;
    margin-top: 20px;
    color: #bdd3ee;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px clamp(24px, 3vw, 40px);
    margin-top: clamp(48px, 7vw, 88px);
  }

  li {
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }

  svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: #a9d2ff;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  h3 {
    margin-top: 16px;
    font-size: 18px;
    font-weight: 620;
    letter-spacing: -0.016em;
  }

  li p {
    margin-top: 6px;
    color: #bdd3ee;
    font-size: 15px;
    line-height: 1.45;
  }

  .disclaimer {
    margin-top: 48px;
    color: #bdd3ee;
    font-size: 14px;
  }

  @media (max-width: 680px) {
    .top {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
