---
import { PRO_LIFETIME_PRICE } from "../../lib/launch";
import Mascot from "../Mascot.astro";
import SectionHead from "../SectionHead.astro";

const usd = (amount: number) => `$${amount.toFixed(2)}`;

const trialDays = 7;

// Planned launch prices in USD. Everything shown on the page derives from these.
const plans = [
  {
    id: "free",
    name: "Free",
    pitch: "A real start with the habits that matter most.",
    features: [
      [
        "Up to 3 habits",
        "Custom names and colors, daily or weekly goals, and your own schedule.",
      ],
      [
        "Your contribution graph and streaks",
        "Watch your year fill in, one day at a time.",
      ],
      [
        "One companion",
        "Earn XP and gems, collect badges, and unlock starter outfits.",
      ],
      ["2 widgets", "Keep your habits on your Home or Lock Screen."],
    ],
  },
  {
    id: "pro",
    name: "Pro",
    pitch: "Everything you need to make your habits stick.",
    monthly: 2.79,
    annual: 19.99,
    lifetime: PRO_LIFETIME_PRICE,
    includes: "Everything in Free, plus",
    features: [
      [
        "Unlimited habits",
        "Track your whole routine, with no limit on what you can add.",
      ],
      [
        "Every widget",
        "Checklist, graph, streak, and progress on your Home and Lock Screen.",
      ],
      [
        "The Mac app",
        "Check in on a bigger screen, with the same widgets on your desktop.",
      ],
      [
        "Full insights and monthly reports",
        "Completion trends, habit-by-habit rates, and milestones, so you can see what's working.",
      ],
      [
        "Duo mode",
        "Share a graph with a partner or friend and keep each other going.",
      ],
      [
        "Group challenges",
        "Invite friends or the whole family, with a leaderboard, shared graph, and shared rewards.",
      ],
      [
        "Both companions, fully dressed",
        "Every outfit, color, and theme, to style them and the app however you like.",
      ],
      ["Early access", "Try new features before anyone else."],
    ],
  },
];

const saving = (monthly: number, annual: number) =>
  Math.round((1 - annual / (monthly * 12)) * 100);
const bestSaving = Math.max(
  ...plans.map((p) => (p.monthly ? saving(p.monthly, p.annual) : 0)),
);
---

<section
  class="section"
  id="pricing"
  aria-labelledby="pricing-title"
  data-pricing
  data-billing="annual"
>
  <div class="page">
    <SectionHead
      id="pricing-title"
      eyebrow="Pricing"
      title="Start free. Grow when you're ready."
      lead={`Free gets you started. Pro has everything else: pay monthly or annually with a ${trialDays}-day free trial, or pay once for lifetime access.`}
      center
    />

    <ul class="plans reveal">
      {plans.map((plan) => (
        <li class:list={["plan", plan.id]}>
          {plan.id === "pro" && <p class="badge">Recommended</p>}
          <div class="art" aria-hidden="true">
            {plan.id === "free" && (
              <div class="one">
                <Mascot sizes="140px" />
              </div>
            )}
            {plan.id === "pro" && (
              <>
                <div class="one">
                  <Mascot accessories={["crown", "bowtie"]} sizes="140px" />
                </div>
                <div class="one">
                  <Mascot
                    character="pink"
                    accessories={["glasses", "tiara"]}
                    sizes="140px"
                  />
                </div>
              </>
            )}
          </div>

          <h3>{plan.name}</h3>
          <p class="pitch">{plan.pitch}</p>

          {plan.monthly ? (
            <>
              <div class="switch" role="group" aria-label="Billing period">
                <button
                  type="button"
                  aria-pressed="false"
                  data-billing-btn="monthly"
                >
                  Monthly
                </button>
                <button
                  type="button"
                  aria-pressed="true"
                  data-billing-btn="annual"
                >
                  Annual <span class="save">Save {bestSaving}%</span>
                </button>
                <button
                  type="button"
                  aria-pressed="false"
                  data-billing-btn="lifetime"
                >
                  Lifetime
                </button>
              </div>
              <div class="price" data-show="annual">
                <p class="trial">{trialDays} days free</p>
                <p>
                  <b>{usd(plan.annual / 12)}</b> / month
                </p>
                <p class="billed">
                  Then {usd(plan.annual)} billed annually. Save{" "}
                  {saving(plan.monthly, plan.annual)}%.
                </p>
              </div>
              <div class="price" data-show="monthly">
                <p class="trial">{trialDays} days free</p>
                <p>
                  <b>{usd(plan.monthly)}</b> / month
                </p>
                <p class="billed">Then billed monthly. Cancel anytime.</p>
              </div>
              <div class="price" data-show="lifetime">
                <p class="trial">Pay once</p>
                <p>
                  <b>{usd(plan.lifetime)}</b> one time
                </p>
                <p class="billed">No subscription. Yours for life.</p>
              </div>
            </>
          ) : (
            <div class="price">
              <p class="trial">Free forever</p>
              <p>
                <b>$0</b>
              </p>
              <p class="billed">No payment needed</p>
            </div>
          )}

          {plan.includes && <p class="includes">{plan.includes}</p>}
          <ul class="features">
            {plan.features.map(([name, detail]) => (
              <li>
                <b>{name}</b>
                <span>{detail}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <p class="note foot reveal">
      Planned launch pricing in USD. The {trialDays}-day trial is for new
      monthly and annual subscribers, and you won't be charged if you cancel at
      least 24 hours before it ends. Consistly isn't available yet, and plans,
      features, and prices may change before release.
    </p>
  </div>
</section>

<style>
  .switch {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
    height: var(--switch-h);
    margin-top: 18px;
    padding: 3px;
    background: rgb(255 255 255 / 0.12);
    border-radius: 14px;
  }

  .switch button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .switch [aria-pressed="true"] {
    background: var(--surface);
    color: var(--blue-deep);
    font-weight: 600;
  }

  .save {
    color: var(--pink-soft);
    font-size: 11px;
    font-weight: 600;
  }

  [aria-pressed="true"] .save {
    color: var(--pink-text);
  }

  [data-show] {
    display: none;
  }

  [data-billing="monthly"] [data-show="monthly"],
  [data-billing="annual"] [data-show="annual"],
  [data-billing="lifetime"] [data-show="lifetime"] {
    display: block;
  }

  .plans {
    --switch-h: 54px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 880px;
    margin-inline: auto;
    gap: 16px;
    align-items: stretch;
    margin-top: 28px;
  }

  .plan {
    position: relative;
    padding: clamp(20px, 2.4vw, 30px);
    border-radius: 24px;
  }

  .free {
    background: var(--blue-bg);
  }

  /* The plan to look at first. */
  .pro {
    --muted: #c6d2e4;
    background: var(--navy);
    color: #fff;
    box-shadow: 0 18px 44px rgb(18 48 90 / 0.24);
  }

  .badge {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 1;
    padding: 4px 11px;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    background: var(--pink-soft);
    border-radius: 99px;
    color: var(--pink-text);
    font-size: 13px;
    font-weight: 600;
  }

  .art {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    aspect-ratio: 3 / 1;
    margin-bottom: 20px;
  }

  .art > div {
    flex: none;
    width: 32%;
  }

  h3 {
    font-size: clamp(26px, 2.8vw, 32px);
    font-weight: 680;
    letter-spacing: -0.028em;
    line-height: 1.1;
  }

  .pitch {
    margin-top: 6px;
    color: var(--muted);
    font-size: 16px;
    letter-spacing: -0.008em;
    text-wrap: pretty;
  }

  .price {
    margin-top: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgb(128 128 128 / 0.22);
    font-size: 16px;
  }

  .trial {
    width: fit-content;
    margin-bottom: 8px;
    padding: 3px 10px;
    background: var(--pink-soft);
    border-radius: 99px;
    color: var(--pink-text);
    font-size: 13px;
    font-weight: 600;
  }

  .free .trial {
    background: var(--surface);
    color: var(--blue-deep);
  }

  .price b {
    font-size: clamp(36px, 3.8vw, 44px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .billed {
    margin-top: 2px;
    color: var(--muted);
    font-size: 14px;
  }

  .includes {
    margin-top: 18px;
    font-size: 15px;
    font-weight: 600;
  }

  .features {
    display: grid;
    gap: 14px;
    margin-top: 14px;
    font-size: 15px;
  }

  .free .features {
    margin-top: 18px;
  }

  .features li {
    position: relative;
    padding-left: 24px;
  }

  .features b {
    display: block;
    font-weight: 600;
  }

  .features span {
    display: block;
    margin-top: 1px;
    color: var(--muted);
    font-size: 14px;
    text-wrap: pretty;
  }

  /* A filled day from the graph stands in for a check mark. */
  .features li::before {
    content: "";
    position: absolute;
    top: 0.3em;
    left: 0;
    width: 13px;
    height: 13px;
    background: var(--blue-accent);
    border-radius: 22%;
  }

  .pro .features li::before {
    background: var(--pink-primary);
  }

  .foot {
    margin-top: 20px;
    text-align: center;
  }

  /* Keeps the prices lined up across the two cards. */
  @media (min-width: 861px) {
    .pitch {
      min-height: 2lh;
    }

    .free .price {
      margin-top: calc(36px + var(--switch-h));
    }
  }

  @media (max-width: 860px) {
    .plans {
      grid-template-columns: minmax(0, 1fr);
    }

    .art {
      width: 100%;
      max-width: 380px;
      margin-inline: auto;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-pricing]");
  const buttons =
    root?.querySelectorAll<HTMLButtonElement>("[data-billing-btn]");

  buttons?.forEach((button) =>
    button.addEventListener("click", () => {
      if (root) root.dataset.billing = button.dataset.billingBtn;
      buttons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b === button)),
      );
    }),
  );
</script>
