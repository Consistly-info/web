---
import { BLOOM_PRICE } from "../../lib/launch";
import Mascot from "../Mascot.astro";
import SectionHead from "../SectionHead.astro";

const usd = (amount: number) => `$${amount.toFixed(2)}`;

const trialDays = 7;

// Planned launch prices in USD. Everything shown on the page derives from these.
const plans = [
  {
    id: "seed",
    name: "Seed",
    pitch: "A real start with the habits that matter most.",
    features: [
      [
        "Up to 3 habits",
        "Custom names and colors, daily or weekly goals, and your own schedule.",
      ],
      [
        "Your contribution graph and streaks",
        "Watch your year fill in, one day at a time.",
      ],
      [
        "One companion",
        "Earn XP and gems, collect badges, and unlock starter outfits.",
      ],
      ["2 widgets", "Keep your habits on your Home or Lock Screen."],
    ],
  },
  {
    id: "grow",
    name: "Grow",
    pitch: "Everything you need to make your habits stick.",
    monthly: 2.79,
    annual: 19.99,
    includes: "Everything in Seed, plus",
    features: [
      [
        "Unlimited habits",
        "Track your whole routine, with no limit on what you can add.",
      ],
      [
        "Every widget",
        "Checklist, graph, streak, and progress on your Home and Lock Screen.",
      ],
      [
        "The Mac app",
        "Check in on a bigger screen, with the same widgets on your desktop.",
      ],
      [
        "Full insights",
        "Completion trends, habit-by-habit rates, and milestones, so you can see what's working.",
      ],
      [
        "Duo mode",
        "Share a graph with a partner or friend and keep each other going.",
      ],
      [
        "Both companions",
        "Meet the whole pair, with more outfits and colors to unlock.",
      ],
    ],
  },
  {
    id: "bloom",
    name: "Bloom",
    pitch: "Pay once for the fun extras, and keep them for life.",
    lifetime: BLOOM_PRICE,
    includes: "Everything in Grow, plus",
    features: [
      [
        "Group challenges",
        "Invite friends or the whole family, with a leaderboard, shared graph, and shared rewards.",
      ],
      [
        "Every outfit, color, and theme",
        "Dress up your companions and style the app however you like.",
      ],
      [
        "Monthly reports and a year in review",
        "A look back at how far you've come, every month and every year.",
      ],
      [
        "Custom app icons",
        "Pick the icon that looks best on your Home Screen.",
      ],
      ["Early access", "Try new features before anyone else."],
    ],
  },
];

const saving = (monthly: number, annual: number) =>
  Math.round((1 - annual / (monthly * 12)) * 100);
const bestSaving = Math.max(
  ...plans.map((p) => (p.monthly ? saving(p.monthly, p.annual) : 0)),
);
---

<section
  class="section"
  id="pricing"
  aria-labelledby="pricing-title"
  data-pricing
  data-billing="annual"
>
  <div class="page">
    <SectionHead
      id="pricing-title"
      eyebrow="Pricing"
      title="Start free. Grow when you're ready."
      lead={`Seed gets you started. Grow has everything most people need, and Bloom adds the extras for life. Try Grow free for ${trialDays} days.`}
      center
    />

    <div class="switch reveal" role="group" aria-label="Billing period">
      <button type="button" aria-pressed="false" data-billing-btn="monthly">
        Monthly
      </button>
      <button type="button" aria-pressed="true" data-billing-btn="annual">
        Annual <span class="save">Save {bestSaving}%</span>
      </button>
    </div>

    <ul class="plans reveal">
      {plans.map((plan) => (
        <li class:list={["plan", plan.id]}>
          {plan.id === "grow" && <p class="badge">Recommended</p>}
          <div class="art" aria-hidden="true">
            {plan.id === "seed" && (
              <div class="one">
                <Mascot sizes="140px" />
              </div>
            )}
            {plan.id === "grow" && (
              <>
                <div class="one">
                  <Mascot accessories={["scarf"]} sizes="140px" />
                </div>
                <div class="one">
                  <Mascot character="pink" sizes="140px" />
                </div>
              </>
            )}
            {plan.id === "bloom" && (
              <>
                <div class="one">
                  <Mascot accessories={["beanie"]} sizes="140px" />
                </div>
                <div class="one">
                  <Mascot accessories={["crown", "bowtie"]} sizes="140px" />
                </div>
                <div class="one">
                  <Mascot
                    character="pink"
                    accessories={["glasses"]}
                    sizes="140px"
                  />
                </div>
              </>
            )}
          </div>

          <h3>{plan.name}</h3>
          <p class="pitch">{plan.pitch}</p>

          {plan.monthly ? (
            <>
              <div class="price" data-show="annual">
                <p class="trial">{trialDays} days free</p>
                <p>
                  <b>{usd(plan.annual / 12)}</b> / month
                </p>
                <p class="billed">
                  Then {usd(plan.annual)} billed annually. Save{" "}
                  {saving(plan.monthly, plan.annual)}%.
                </p>
              </div>
              <div class="price" data-show="monthly">
                <p class="trial">{trialDays} days free</p>
                <p>
                  <b>{usd(plan.monthly)}</b> / month
                </p>
                <p class="billed">Then billed monthly. Cancel anytime.</p>
              </div>
            </>
          ) : plan.lifetime ? (
            <div class="price">
              <p class="trial">Pay once</p>
              <p>
                <b>{usd(plan.lifetime)}</b> one time
              </p>
              <p class="billed">No subscription. Yours for life.</p>
            </div>
          ) : (
            <div class="price">
              <p class="trial">Free forever</p>
              <p>
                <b>$0</b>
              </p>
              <p class="billed">No payment needed</p>
            </div>
          )}

          {plan.includes && <p class="includes">{plan.includes}</p>}
          <ul class="features">
            {plan.features.map(([name, detail]) => (
              <li>
                <b>{name}</b>
                <span>{detail}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <p class="note foot reveal">
      Planned launch pricing in USD. The {trialDays}-day Grow trial is for new
      subscribers, and you won't be charged if you cancel at least 24 hours
      before it ends. Consistly isn't available yet, and plans, features, and
      prices may change before release.
    </p>
  </div>
</section>

<style>
  .switch {
    display: flex;
    width: fit-content;
    gap: 2px;
    margin: clamp(28px, 4vw, 40px) auto 0;
    padding: 3px;
    background: var(--sky-soft);
    border-radius: 99px;
  }

  .switch button {
    min-height: 40px;
    padding-inline: 16px;
    border-radius: 99px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .switch [aria-pressed="true"] {
    background: var(--surface);
    color: var(--blue-deep);
    font-weight: 600;
    box-shadow: 0 1px 3px rgb(18 40 70 / 0.14);
  }

  .save {
    margin-left: 4px;
    color: var(--pink-text);
    font-weight: 600;
  }

  [data-billing="annual"] [data-show="monthly"],
  [data-billing="monthly"] [data-show="annual"] {
    display: none;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
    margin-top: 28px;
  }

  .plan {
    position: relative;
    padding: clamp(20px, 2.4vw, 30px);
    border-radius: 24px;
  }

  .seed {
    background: var(--blue-bg);
  }

  /* The plan to look at first. */
  .grow {
    --muted: #c6d2e4;
    background: var(--navy);
    color: #fff;
    box-shadow: 0 18px 44px rgb(18 48 90 / 0.24);
  }

  .bloom {
    background: linear-gradient(135deg, var(--blue-bg), var(--pink-bg));
  }

  .badge {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 1;
    padding: 4px 11px;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    background: var(--pink-soft);
    border-radius: 99px;
    color: var(--pink-text);
    font-size: 13px;
    font-weight: 600;
  }

  .art {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    aspect-ratio: 3 / 1;
    margin-bottom: 20px;
  }

  .art > div {
    flex: none;
    width: 32%;
  }

  h3 {
    font-size: clamp(26px, 2.8vw, 32px);
    font-weight: 680;
    letter-spacing: -0.028em;
    line-height: 1.1;
  }

  .pitch {
    margin-top: 6px;
    color: var(--muted);
    font-size: 16px;
    letter-spacing: -0.008em;
    text-wrap: pretty;
  }

  .price {
    margin-top: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgb(128 128 128 / 0.22);
    font-size: 16px;
  }

  .trial {
    width: fit-content;
    margin-bottom: 8px;
    padding: 3px 10px;
    background: var(--pink-soft);
    border-radius: 99px;
    color: var(--pink-text);
    font-size: 13px;
    font-weight: 600;
  }

  .seed .trial {
    background: var(--surface);
    color: var(--blue-deep);
  }

  .price b {
    font-size: clamp(36px, 3.8vw, 44px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .billed {
    margin-top: 2px;
    color: var(--muted);
    font-size: 14px;
  }

  .includes {
    margin-top: 18px;
    font-size: 15px;
    font-weight: 600;
  }

  .features {
    display: grid;
    gap: 14px;
    margin-top: 14px;
    font-size: 15px;
  }

  .seed .features {
    margin-top: 18px;
  }

  .features li {
    position: relative;
    padding-left: 24px;
  }

  .features b {
    display: block;
    font-weight: 600;
  }

  .features span {
    display: block;
    margin-top: 1px;
    color: var(--muted);
    font-size: 14px;
    text-wrap: pretty;
  }

  /* A filled day from the graph stands in for a check mark. */
  .features li::before {
    content: "";
    position: absolute;
    top: 0.3em;
    left: 0;
    width: 13px;
    height: 13px;
    background: var(--blue-accent);
    border-radius: 22%;
  }

  .grow .features li::before {
    background: var(--pink-primary);
  }

  .bloom .features li:nth-child(even)::before {
    background: var(--pink-accent);
  }

  .foot {
    margin-top: 20px;
    text-align: center;
  }

  /* Keeps the prices lined up across the three cards. */
  @media (min-width: 861px) {
    .pitch {
      min-height: 2lh;
    }
  }

  @media (max-width: 860px) {
    .plans {
      grid-template-columns: minmax(0, 1fr);
    }

    .art {
      width: 100%;
      max-width: 380px;
      margin-inline: auto;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-pricing]");
  const buttons =
    root?.querySelectorAll<HTMLButtonElement>("[data-billing-btn]");

  buttons?.forEach((button) =>
    button.addEventListener("click", () => {
      if (root) root.dataset.billing = button.dataset.billingBtn;
      buttons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b === button)),
      );
    }),
  );
</script>
