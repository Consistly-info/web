---
import { LIFETIME_PRICE, REMAINING, TOTAL_SPOTS } from "../lib/launch";
import Logo from "./Logo.astro";

const links = [
  { href: "#features", label: "Features" },
  { href: "#challenges", label: "Together" },
  { href: "#about", label: "About" },
  { href: "#pricing", label: "Pricing" },
  { href: "#faq", label: "FAQ" },
];
---

<header class="nav">
  <a class="offer" href="#whitelist">
    <span class="offer-text">
      <b>Lifetime access for ${LIFETIME_PRICE}</b>
      <span class="wide">for the first {TOTAL_SPOTS} members</span>
      <span class="left">{REMAINING} spots left</span>
    </span>
    <span class="offer-cta">
      Join<span class="wide"> the whitelist</span>
    </span>
  </a>

  <div class="page nav-bar">
    <a class="brand" href="#top" aria-label="Consistly, back to top">
      <Logo />
      <span>Consistly</span>
    </a>

    <nav aria-label="Main">
      <ul class="links" id="nav-links">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="end">
      <span class="soon">Coming Soon</span>
      <button
        class="toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-links"
        aria-label="Menu"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.94);
    border-bottom: 1px solid var(--line);
  }

  /* Both companions' colors, dark enough to hold white text from end to end. */
  .offer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    height: var(--offer-h);
    padding-inline: 12px;
    background: linear-gradient(90deg, var(--blue-deep), var(--pink-text));
    color: #fff;
    font-size: 14px;
    letter-spacing: -0.008em;
    text-decoration: none;
    white-space: nowrap;
  }

  .offer-text {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .offer b {
    font-weight: 650;
  }

  .left {
    margin-left: 6px;
    padding: 1px 9px;
    background: rgb(255 255 255 / 0.2);
    border-radius: 99px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .offer-cta {
    padding: 3px 12px;
    background: #fff;
    border-radius: 99px;
    color: var(--blue-deep);
    font-size: 13px;
    font-weight: 650;
    transition: background 0.2s;
  }

  .offer:hover .offer-cta {
    background: var(--pink-soft);
  }

  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 56px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 17px;
    font-weight: 650;
    letter-spacing: -0.022em;
    text-decoration: none;
  }

  .links {
    display: flex;
    gap: 32px;
  }

  .links a {
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
    transition: color 0.2s;
  }

  .links a:hover {
    color: var(--ink);
  }

  .end {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .end .soon {
    padding-block: 5px;
    font-size: 13px;
  }

  .toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -10px;
  }

  .toggle span {
    position: absolute;
    left: 13px;
    width: 18px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.25s var(--ease);
  }

  .toggle span:first-child {
    transform: translateY(-3.5px);
  }

  .toggle span:last-child {
    transform: translateY(3.5px);
  }

  .toggle[aria-expanded="true"] span:first-child {
    transform: rotate(45deg);
  }

  .toggle[aria-expanded="true"] span:last-child {
    transform: rotate(-45deg);
  }

  @media (max-width: 360px) {
    .nav-bar {
      gap: 8px;
    }

    .brand {
      gap: 6px;
      font-size: 15px;
    }

    .end {
      gap: 2px;
    }

    .end .soon {
      padding-inline: 10px;
      font-size: 12px;
    }
  }

  @media (max-width: 680px) {
    .wide {
      display: none;
    }

    .offer {
      gap: 8px;
      font-size: 13px;
    }

    .left {
      margin-left: 0;
      padding-inline: 7px;
    }

    .toggle {
      display: block;
    }

    .links {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      flex-direction: column;
      gap: 0;
      padding: 8px var(--gutter) 20px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }

    .links.is-open {
      display: flex;
    }

    .links a {
      display: block;
      padding: 13px 0;
      color: var(--ink);
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.02em;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".toggle");
  const links = document.querySelector<HTMLElement>("#nav-links");

  if (toggle && links) {
    const setOpen = (open: boolean) => {
      links.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    links.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && links.classList.contains("is-open")) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
