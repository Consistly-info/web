---
import Widget from "../Widget.astro";
import Logo from "../Logo.astro";

const apps = ["#e8b64c", "#6aa5d8", "#e2795f", "Consistly"];
---

<div class="home" aria-hidden="true">
  <Widget kind="graph" />
  <div class="pair">
    <Widget kind="streak" />
    <Widget kind="progress" />
  </div>
  <Widget kind="checklist" />
  <div class="apps">
    {apps.map((app) =>
      app === "Consistly" ? (
        <span class="app own">
          <Logo size={32} />
        </span>
      ) : (
        <span class="app" style={`background:${app}`} />
      ),
    )}
  </div>
  <div class="dock">
    <span class="app" style="background:#7fc08b"></span>
    <span class="app" style="background:#5f8fbd"></span>
    <span class="app" style="background:#d9dee5"></span>
    <span class="app" style="background:#b08fd1"></span>
  </div>
</div>

<style>
  .home {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--u) * 16);
    padding-top: calc(var(--u) * 64);
    background: linear-gradient(170deg, #d6e8fc 0%, #b1d2f6 55%, #84b3ea 100%);
  }

  .pair {
    display: flex;
    gap: calc(var(--u) * 22);
  }

  .apps {
    display: flex;
    gap: calc(var(--u) * 24);
  }

  .app {
    display: block;
    width: calc(var(--u) * 62);
    height: calc(var(--u) * 62);
    border-radius: calc(var(--u) * 14);
  }

  .own :global(svg) {
    width: 100%;
    height: 100%;
  }

  .dock {
    position: absolute;
    inset: auto calc(var(--u) * 10) calc(var(--u) * 10);
    display: flex;
    justify-content: center;
    gap: calc(var(--u) * 24);
    padding-block: calc(var(--u) * 14);
    background: rgb(255 255 255 / 0.36);
    border-radius: calc(var(--u) * 34);
  }
</style>
