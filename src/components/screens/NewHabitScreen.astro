---
const days = ["M", "T", "W", "T", "F", "S", "S"];
const on = [true, true, true, true, true, false, true];
---

<div class="sheet">
  <div class="bar">
    <span class="link">Cancel</span>
    <b>New Habit</b>
    <span class="link strong">Add</span>
  </div>

  <div class="field name">
    <span class="dot"></span>
    <span>Read 20 pages</span>
  </div>

  <p class="label">Goal</p>
  <div class="segments">
    <span>Daily</span>
    <span class="on">Weekly</span>
  </div>
  <div class="field between">
    <span>Target</span>
    <b>6 days a week</b>
  </div>

  <p class="label">Schedule</p>
  <div class="days">
    {days.map((day, i) => (
      <span class:list={{ on: on[i] }}>{day}</span>
    ))}
  </div>
  <div class="field between">
    <span>Reminder</span>
    <b>7:30 PM</b>
  </div>

  <p class="label">Progress</p>
  <div class="streak">
    <div>
      <p class="num">9</p>
      <p class="cap">Current streak</p>
    </div>
    <div>
      <p class="num">83%</p>
      <p class="cap">This month</p>
    </div>
  </div>
</div>

<style>
  .sheet {
    height: 100%;
    padding: calc(var(--u) * 66) calc(var(--u) * 18) 0;
    font-size: calc(var(--u) * 15.5);
  }

  .bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: calc(var(--u) * 18);
  }

  .bar b {
    font-size: calc(var(--u) * 17);
  }

  .link {
    color: var(--blue-deep);
  }

  .strong {
    font-weight: 650;
  }

  .field {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 12);
    padding: calc(var(--u) * 13) calc(var(--u) * 15);
    background: #fff;
    border-radius: calc(var(--u) * 14);
  }

  .between {
    justify-content: space-between;
    margin-top: calc(var(--u) * 8);
  }

  .between b {
    color: var(--blue-deep);
    font-weight: 600;
  }

  .name {
    font-size: calc(var(--u) * 18);
    font-weight: 600;
  }

  .dot {
    width: calc(var(--u) * 24);
    height: calc(var(--u) * 24);
    background: #0e9f8e;
    border-radius: 50%;
  }

  .label {
    margin: calc(var(--u) * 20) 0 calc(var(--u) * 8) calc(var(--u) * 4);
    color: #6b6b6b;
    font-size: calc(var(--u) * 13);
    font-weight: 600;
  }

  .segments {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: calc(var(--u) * 3);
    background: #e6ebf2;
    border-radius: calc(var(--u) * 11);
    text-align: center;
  }

  .segments span {
    padding-block: calc(var(--u) * 7);
    border-radius: calc(var(--u) * 9);
    font-weight: 500;
  }

  .segments .on {
    background: #fff;
    font-weight: 650;
  }

  .days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: calc(var(--u) * 6);
  }

  .days span {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: #e6ebf2;
    border-radius: 50%;
    color: #5f5f5f;
    font-size: calc(var(--u) * 14);
    font-weight: 600;
  }

  .days .on {
    background: var(--blue);
    color: #fff;
  }

  .streak {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: calc(var(--u) * 14) calc(var(--u) * 15);
    background: var(--sky);
    border-radius: calc(var(--u) * 16);
    color: var(--blue-deep);
  }

  .num {
    font-size: calc(var(--u) * 30);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .cap {
    font-size: calc(var(--u) * 13);
  }
</style>
