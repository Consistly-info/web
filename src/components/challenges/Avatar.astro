---
// Placeholder profile picture: the companion's face, dressed differently per person.
import Mascot from "../Mascot.astro";
import type { Person } from "../../lib/challenge";

interface Props {
  person: Person;
}

const { person } = Astro.props;
const accessories = { you: [], alex: [], sam: ["glasses"] } as const;
const character = person === "alex" ? "pink" : "blue";
---

<span class:list={["avatar", person]} aria-hidden="true">
  <Mascot
    character={character}
    sizes="60px"
    accessories={[...accessories[person]]}
  />
</span>

<style>
  .avatar {
    display: block;
    flex: none;
    width: var(--avatar, 40px);
    height: var(--avatar, 40px);
    overflow: hidden;
    border-radius: 50%;
  }

  .avatar :global(.mascot) {
    transform: translateY(26%) scale(1.5);
  }

  .you {
    background: var(--blue-primary);
  }

  .alex {
    background: var(--pink-primary);
  }

  .sam {
    background: #d8dee6;
  }
</style>
