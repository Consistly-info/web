---
import Avatar from "./Avatar.astro";
import Mascot from "../Mascot.astro";
import { LEADERBOARD } from "../../lib/challenge";
---

<div class="board">
  <h3>90-Day Gym Challenge</h3>
  <p class="sub">Leaderboard, last 5 weeks</p>
  <ol>
    {LEADERBOARD.map((row, i) => (
      <li>
        <span class="rank">{i + 1}</span>
        <Avatar person={row.person} />
        <div class="info">
          <div class="line">
            <b>{row.name}</b>
            <span class="count">
              {row.sessions}/{row.goal} sessions
            </span>
            <span class="rate">{row.rate}%</span>
          </div>
          <div class="track">
            <span class={row.person} style={`width:${row.rate}%`} />
          </div>
        </div>
      </li>
    ))}
  </ol>

  <div class="nudge">
    <div class="art">
      <Mascot sizes="90px" accessories={["scarf"]} />
    </div>
    <p>
      <b>Alex is one session behind you.</b> A little friendly pressure goes a
      long way.
    </p>
  </div>
</div>

<style>
  .board {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .nudge {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding: 12px 16px 12px 8px;
    background: var(--sky-soft);
    border-radius: 16px;
    font-size: 15px;
    line-height: 1.35;
  }

  ol {
    margin-bottom: 24px;
  }

  .art {
    flex: none;
    width: 84px;
  }

  .nudge b {
    font-weight: 620;
  }

  h3 {
    font-size: 20px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .sub {
    color: var(--muted);
    font-size: 14px;
  }

  ol {
    display: grid;
    gap: 22px;
    margin-top: 24px;
    --avatar: 44px;
  }

  li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .rank {
    width: 14px;
    color: var(--muted);
    font-size: 15px;
    font-weight: 600;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .info {
    flex: 1;
    min-width: 0;
  }

  .line {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 16px;
  }

  .line b {
    font-weight: 620;
  }

  .count {
    color: var(--muted);
    font-size: 14px;
  }

  .rate {
    margin-left: auto;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .track {
    height: 8px;
    margin-top: 7px;
    overflow: hidden;
    background: var(--heat-0);
    border-radius: 99px;
  }

  .track span {
    display: block;
    height: 100%;
    border-radius: 99px;
  }

  .you {
    background: #36b36a;
  }

  .alex {
    background: #4a8bdc;
  }

  .sam {
    background: #9d86e0;
  }
</style>
