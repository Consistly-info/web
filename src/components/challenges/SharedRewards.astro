---
import Mascot from "../Mascot.astro";

const earned = [
  { value: "+150 XP", label: "Each weekly goal you hit together" },
  { value: "+40 gems", label: "For every shared milestone" },
];

const badges = [
  {
    name: "Kitchen Partners",
    text: "Challenge badge",
    icon: "M5 11h14v6a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-6ZM3 11h18M9 7V5M15 7V5",
  },
  {
    name: "Better Together",
    text: "Friendship achievement",
    icon: "M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z",
  },
  {
    name: "Halfway There",
    text: "Shared milestone",
    icon: "m12 4 2.5 5.2 5.7.8-4.1 4 1 5.7L12 17l-5.1 2.7 1-5.7-4.1-4 5.7-.8L12 4Z",
  },
];

const WEEKS = 13;
const DONE = 9;
---

<div class="rewards reveal">
  <div class="art">
    <div class="pair">
      <div>
        <Mascot
          accessories={["scarf"]}
          sizes="220px"
          label="Your companion in the matching challenge scarf"
        />
      </div>
      <div>
        <Mascot
          character="pink"
          accessories={["scarf"]}
          sizes="220px"
          label="Mia's companion in the matching challenge scarf"
        />
      </div>
    </div>
    <p class="art-title">Matching challenge scarves</p>
    <p class="art-text">
      A special accessory for your companions, unlocked by finishing a challenge
      together.
    </p>
  </div>

  <div class="detail">
    <h3>Earn more when you finish together.</h3>

    <dl class="earned">
      {earned.map((item) => (
        <div>
          <dt>{item.value}</dt>
          <dd>{item.label}</dd>
        </div>
      ))}
    </dl>

    <ul class="badges">
      {badges.map((badge) => (
        <li>
          <span class="medal">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={badge.icon} />
            </svg>
          </span>
          <b>{badge.name}</b>
          <span class="kind">{badge.text}</span>
        </li>
      ))}
    </ul>

    <div class="weeks">
      <p>
        Weekly milestones{" "}
        <span>
          Week {DONE} of {WEEKS}
        </span>
      </p>
      <ol aria-label={`${DONE} of ${WEEKS} weeks complete`}>
        {Array.from({ length: WEEKS }, (_, i) => (
          <li class:list={{ on: i < DONE }} />
        ))}
      </ol>
    </div>
  </div>
</div>

<style>
  .rewards {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 16px;
    margin-top: 16px;
  }

  .art {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(20px, 2.6vw, 32px);
    /* Each companion stands on its own color. */
    background: linear-gradient(
      90deg,
      var(--blue-soft) 50%,
      var(--pink-soft) 50%
    );
    border-radius: 24px;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: min(100%, 460px);
    margin: 0 auto 16px;
  }

  .art-title {
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.016em;
  }

  .art-text {
    margin-top: 2px;
    color: #3b4657;
    font-size: 15px;
    line-height: 1.4;
  }

  .detail {
    padding: clamp(20px, 2.6vw, 32px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 24px;
  }

  h3 {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 660;
    letter-spacing: -0.026em;
    line-height: 1.15;
  }

  .earned {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 22px;
  }

  dt {
    color: var(--blue-deep);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 680;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  dd {
    margin-top: 3px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.35;
  }

  .badges {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 26px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .badges li {
    display: grid;
    gap: 1px;
  }

  .medal {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 8px;
    background: var(--sky);
    border-radius: 50%;
    color: var(--blue-deep);
  }

  .medal svg {
    width: 56%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .badges b {
    font-size: 15px;
    font-weight: 620;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .kind {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.3;
  }

  .weeks {
    margin-top: 24px;
  }

  .weeks p {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 15px;
    font-weight: 600;
  }

  .weeks span {
    color: var(--muted);
    font-weight: 400;
  }

  .weeks ol {
    display: grid;
    grid-template-columns: repeat(13, minmax(0, 1fr));
    gap: 4px;
    margin-top: 10px;
  }

  .weeks li {
    height: 10px;
    background: var(--heat-0);
    border-radius: 4px;
  }

  .weeks .on {
    background: var(--blue);
  }

  @media (max-width: 860px) {
    .rewards {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 680px) {
    .rewards {
      gap: 8px;
      margin-top: 8px;
    }

    .art,
    .detail {
      padding: 14px;
      border-radius: 18px;
    }

    .pair {
      width: min(56%, 220px);
      margin-bottom: 8px;
    }

    .art-title {
      font-size: 15px;
    }

    .art-text {
      font-size: 13px;
    }

    h3 {
      font-size: 18px;
    }

    .earned {
      gap: 12px;
      margin-top: 10px;
    }

    dt {
      font-size: 21px;
    }

    dd {
      margin-top: 1px;
      font-size: 12px;
    }

    .badges {
      gap: 8px;
      margin-top: 12px;
      padding-top: 10px;
    }

    .medal {
      width: 34px;
      height: 34px;
      margin-bottom: 4px;
    }

    .badges b {
      font-size: 12.5px;
    }

    .kind {
      font-size: 11px;
    }

    .weeks {
      margin-top: 12px;
    }

    .weeks p {
      font-size: 13px;
    }

    .weeks ol {
      gap: 3px;
      margin-top: 6px;
    }

    .weeks li {
      height: 8px;
    }
  }
</style>
