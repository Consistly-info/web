---
// A static contribution graph drawn from the sample data. Size it from the
// parent with --cell and --gap; it shows the most recent `weeks` columns.
import { DAYS, levelOf } from "../lib/sample";

interface Props {
  weeks?: number;
  /** Scatter blue and pink days through the graph, one for each companion. */
  mix?: boolean;
}

const { weeks = 52, mix = false } = Astro.props;
const cells = DAYS.slice(-weeks * 7).map((day) => levelOf(day.mask));

// A small integer hash, so the scatter looks random but every build matches.
const isPink = (index: number) => {
  let hash = Math.imul(index + 1, 0x9e3779b1);
  hash = Math.imul(hash ^ (hash >>> 15), 0x85ebca77);
  return ((hash ^ (hash >>> 13)) & 1) === 1;
};
---

<div class="heat" style={`--weeks:${weeks}`} aria-hidden="true">
  {cells.map((level, i) => (
    <i class:list={[`l${level}`, { p: mix && isPink(i) }]} />
  ))}
</div>

<style>
  .heat {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 1fr);
    grid-template-columns: repeat(var(--weeks), 1fr);
    gap: var(--gap, 3px);
  }

  i {
    aspect-ratio: 1;
    border-radius: var(--cell-r, 22%);
    background: var(--heat-0);
  }

  .l1 {
    background: var(--heat-1);
  }

  .l2 {
    background: var(--heat-2);
  }

  .l3 {
    background: var(--heat-3);
  }

  .l4 {
    background: var(--heat-4);
  }

  .p.l1 {
    background: #ffd9e5;
  }

  .p.l2 {
    background: var(--pink-primary);
  }

  /* The deeper pinks match the weight of the blues they sit beside. */
  .p.l3 {
    background: #ec8fb0;
  }

  .p.l4 {
    background: #d45c8a;
  }
</style>
