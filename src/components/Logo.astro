---
// The mark is a small contribution graph climbing to the right.
interface Props {
  size?: number;
}

const { size = 26 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="7.5" fill="#166534"></rect>
  <g fill="#86efac">
    <rect x="7" y="17.5" width="5" height="5" rx="1.3" opacity=".45"></rect>
    <rect x="13.5" y="17.5" width="5" height="5" rx="1.3" opacity=".7"></rect>
    <rect x="13.5" y="11" width="5" height="5" rx="1.3" opacity=".45"></rect>
    <rect x="20" y="17.5" width="5" height="5" rx="1.3"></rect>
    <rect x="20" y="11" width="5" height="5" rx="1.3" opacity=".8"></rect>
  </g>
</svg>
