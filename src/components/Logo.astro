---
// The logo is the Consistly companion.
import mascot from "../assets/mascot/mascot-240.webp";

interface Props {
  size?: number;
}

const { size = 34 } = Astro.props;
---

<img src={mascot.src} width={size} height={size} alt="" decoding="async" />

<style>
  img {
    display: block;
    flex: none;
  }
</style>
